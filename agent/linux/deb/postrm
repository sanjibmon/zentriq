#!/bin/sh
# Zentriq Agent: after removal. "purge" also removes the enrollment, certificate and logs.
set -e
case "$1" in
  remove|purge) rm -f /opt/zentriq-agent/installed-by; rmdir /opt/zentriq-agent 2>/dev/null || true ;;
esac
if [ "$1" = "purge" ]; then
  rm -rf /var/lib/zentriq-agent /var/log/zentriq-agent /var/spool/zentriq-agent /etc/systemd/system/zentriq-agent.service.d
fi
if [ -d /run/systemd/system ]; then systemctl daemon-reload >/dev/null 2>&1 || true; fi
exit 0
