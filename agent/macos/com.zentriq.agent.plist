<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Zentriq Agent for macOS: launchd daemon (root). KeepAlive restarts it if it stops; AbandonProcessGroup lets an
     agent update (installer -pkg started by the agent) finish while the package replaces and restarts the daemon. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zentriq.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Zentriq/Agent/zentriq-agent</string>
    <string>--service</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>/Library/Logs/Zentriq Agent/launchd.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/Zentriq Agent/launchd.log</string>
</dict>
</plist>
