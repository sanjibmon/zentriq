<Project Sdk="Microsoft.NET.Sdk">
  <!--
    VENDOR-SIDE tool. Never packaged into the customer installer (package-windows.ps1 publishes only the
    API, Worker and zentriqctl). Private signing keys must stay in the vendor's protected key store.
  -->
  
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>zentriq-license-signer</AssemblyName>
    <RootNamespace>Zentriq.LicenseSigner</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\backend\Zentriq.Domain\Zentriq.Domain.csproj" />
    <ProjectReference Include="..\..\..\backend\Zentriq.Application\Zentriq.Application.csproj" />
    <ProjectReference Include="..\..\Zentriq.Licensing.Signing\Zentriq.Licensing.Signing.csproj" />
  </ItemGroup>
</Project>
