<?xml version="1.0" encoding="utf-8"?>
<!-- Welcome → License → Enrollment (code + optional proxy) → Ready → Progress → Finish -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetsDir)\License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)\AgentBanner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)\AgentDialog.bmp" />

    <UI Id="ZentriqAgentUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WixUI_Mode" Value="Minimal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="ZqEnrollDlg" Condition='LicenseAccepted = "1"' />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ZqEnrollDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Dialog Id="ZqEnrollDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Connect to Zentriq" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Paste the enrollment code from the Zentriq Web Console." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="CodeLabel" Type="Text" X="20" Y="56" Width="330" Height="24" NoPrefix="yes"
                 Text="Enrollment code (Zentriq Web Console > Agents > Enrollment codes). It starts with ZQ1. and contains the server address:" />
        <Control Id="Code" Type="Edit" X="20" Y="82" Width="330" Height="18" Property="ENROLLMENTCODE" Text="{2048}" />
        <Control Id="CodeNote" Type="Text" X="20" Y="104" Width="330" Height="36" NoPrefix="yes"
                 Text="You can leave this empty and enroll later from an elevated prompt: &quot;C:\Program Files\Zentriq Agent\ZentriqAgent.exe&quot; --enroll ZQ1...." />
        <Control Id="ProxyLabel" Type="Text" X="20" Y="146" Width="330" Height="12" NoPrefix="yes" Text="HTTP proxy for reaching the server (optional, e.g. http://proxy.example.com:8080):" />
        <Control Id="Proxy" Type="Edit" X="20" Y="160" Width="330" Height="18" Property="PROXYURL" Text="{512}" />
        <Control Id="Note" Type="Text" X="20" Y="186" Width="330" Height="40" NoPrefix="yes"
                 Text="The agent connects out to the server over HTTPS (port 8444 by default). It does not open any inbound port and only reads inventory; it does not change settings on this device." />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
